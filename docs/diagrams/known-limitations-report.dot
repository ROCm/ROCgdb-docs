digraph G {
@graph; @edge; @base;

node [@dark];
start [label="Still stuck after the steps\non this page"];

node [@decision];
c1 [label="Does the application work\nwithout ROCgdb?"];
c2 [label="Does a row in Known limitations\nmatch what you see?"];
c3 [label="Is the problem in the\ndocumentation itself?"];

node [@done];
f1 [label="Fix the application or ROCm\nsetup first. ROCm problems go\nto ROCm/TheRock issues."];
u [label="Use that row's workaround.\nIf it has none, the\nbehavior is expected."];
d [label="Open a ROCgdb-docs issue."];
r [label="Search ROCgdb issues, then\nopen one with the\nevidence below."];

edge [fontname="Helvetica-Bold,Arial,sans-serif"];
start -> c1;
c1 -> f1 [label="No"];
c1 -> c2 [label="Yes"];
c2 -> u [label="Yes"];
c2 -> c3 [label="No"];
c3 -> d [label="Yes"];
c3 -> r [label="No"];

{rank=same; c1; f1}
{rank=same; c2; u}
{rank=same; c3; d}
}
