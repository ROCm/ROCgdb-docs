digraph G {
@graph; @edge; @base;

node [@dark];
start [label="ROCgdb doesn't do\nwhat you expect"];

node [@decision];
c1 [label="1. Does info agents list\nyour GPU with state A?"];
c2 [label="Is its architecture in\nthe supported list?"];
c3 [label="3. Is the GPU code built\nwith -ggdb -O0?"];
c4 [label="4. Does a row in the\nlimitations tables match?"];

node [@action];
f2 [label="2. Read the amd-dbgapi warnings and\nfix the driver, firmware, or runtime"];
f3 [label="Rebuild with -ggdb -O0"];

node [@done];
yes [label="Use the workaround\nin that row"];
rep [label="Report a problem"];
unsup [label="No workaround\non that GPU"];

start -> c1 [weight=10];
c1 -> c2 [@no];
c2 -> f2 [@yes];
c2 -> unsup [@no];
f2 -> c1;
c1 -> c3 [@yes, weight=10];
c3 -> f3 [@no];
f3 -> c3;
c3 -> c4 [@yes, weight=10];
c4 -> yes [@yes, weight=10];
c4 -> rep [@no];

{rank=same; yes; rep}
}
