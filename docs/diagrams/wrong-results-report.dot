digraph G {
@graph; @edge; @base;

node [@dark];
start [label="ROCgdb prints a value that differs from an\nindependent one, such as a printf"];

node [@decision];
c1 [label="Does a row in Known limitations\nmatch what you see?"];
c2 [label="Is the problem in the\ndocumentation itself?"];

node [@done];
u [label="Use that row's workaround.\nIf it has none, the\nbehavior is expected."];
d [label="Open a ROCgdb-docs issue."];
r [label="Search ROCgdb issues, then\nopen one with the\nevidence below."];

edge [fontname="Helvetica-Bold,Arial,sans-serif"];
start -> c1;
c1 -> u [label="Yes"];
c1 -> c2 [label="No"];
c2 -> d [label="Yes"];
c2 -> r [label="No"];

{rank=same; c1; u}
{rank=same; c2; d}
}
