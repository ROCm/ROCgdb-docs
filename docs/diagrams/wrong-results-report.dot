digraph G {
@graph; @edge; @base;

node [@dark];
start [label="ROCgdb's value doesn't match an independent check:\na device printf, the host value after hipMemcpy,\nor the application's output"];

node [@decision];
c1 [label="Does a row in Known limitations\nmatch what you see?"];
c2 [label="Is the problem in the\ndocumentation itself?"];

node [@done];
u [label="Use that row's workaround.\nIf it has none, the behavior is expected"];
d [label="Open a ROCgdb-docs issue"];
r [label="Search ROCgdb issues, then open\none with the evidence below"];

start -> c1;
c1 -> u [@yes];
c1 -> c2 [@no];
c2 -> d [@yes];
c2 -> r [@no];

{rank=same; c1; u}
{rank=same; c2; d}
}
