digraph G {
@graph; @edge; @base;

node [@dark];
start [label="Some output values are wrong"];

node [@decision];
c1 [label="1. Does catch hiperr stop\non a HIP error?"];
c4 [label="4. Are the values this\nwork-item reads correct?"];
c5 [label="5. Step and print. Does the value\ngo wrong in this work-item?"];

node [@action];
s2 [label="2. Work out which work-item\nwrote a wrong element"];
s3 [label="3. Stop only that work-item\nwith a conditional breakpoint"];
s6 [label="6. The value is right here, so watch\nthe output to see what overwrites it"];

node [@done];
f1 [label="Fix the failing HIP call.\nThe kernel might be fine"];
f4 [label="The bug is earlier: a host copy or\nthe kernel that produced the input"];
ok [label="You found the line. Fix the code"];

start -> c1;
c1 -> f1 [@yes];
c1 -> s2 [@no];
s2 -> s3 -> c4;
c4 -> f4 [@no];
c4 -> c5 [@yes];
c5 -> ok [@yes];
c5 -> s6 [@no];

{rank=same; c1; f1}
{rank=same; c4; f4}
{rank=same; c5; ok}
}
