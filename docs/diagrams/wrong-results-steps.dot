digraph G {
@graph; @edge; @base;

node [@dark];
start [label="Some output values are wrong"];

node [@decision];
c1 [label="1. Does catch hiperr stop\non a HIP error?"];
c4 [label="4. Are the values\nthis work-item reads correct?"];
c5 [label="5. Step and print. Does the\nvalue go wrong in this work-item?"];

node [@action];
s2 [label="2. Work out which work-item\nwrote a wrong element"];
s3 [label="3. Stop only that work-item\nwith a conditional breakpoint"];
s6 [label="6. The value is right here.\nWatch the output to find\nwhat overwrites it"];

node [@done];
f1 [label="Fix the failing HIP call.\nThe kernel might be fine."];
f4 [label="The bug is earlier: a host copy\nor the kernel that made the input."];
ok [label="You found the line.\nFix the code."];
fin [label="You found the write\nthat changes the value."];

edge [fontname="Helvetica-Bold,Arial,sans-serif"];
start -> c1;
c1 -> f1 [label="Yes"];
c1 -> s2 [label="No"];
s2 -> s3 -> c4;
c4 -> f4 [label="No"];
c4 -> c5 [label="Yes"];
c5 -> ok [label="Yes"];
c5 -> s6 [label="No"];
s6 -> fin;

{rank=same; c1; f1}
{rank=same; c4; f4}
{rank=same; c5; ok}
}
