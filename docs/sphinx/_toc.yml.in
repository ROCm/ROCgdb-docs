# Anywhere {branch} is used, the branch name will be substituted.
# These comments will also be removed.
root: index
subtrees:
  - caption: Install
    entries:
    - file: install/installation
      title: Installation
  - caption: Quick reference
    entries:
    - file: how-to/quick-start
      title: Quick start
    - file: quick-reference/essential-commands
      title: Commands for key operations
  - caption: How to
    entries:
    - url: http://rocm.docs.amd.com/projects/ROCgdb/en/${branch}/ROCgdb/gdb/doc/gdb/index.html
      title: User guide
    - url: https://rocm.docs.amd.com/projects/ROCgdb/en/${branch}/_static/pdf/ROCgdb/gdb.pdf
      title: User guide pdf
    - file: how-to/setting-gdb-tui
    - file: how-to/setting-vsc-gui
    - file: how-to/debugging-python
  - caption: About
    entries:
    - file: license
