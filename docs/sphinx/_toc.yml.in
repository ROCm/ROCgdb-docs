# Anywhere {branch} is used, the branch name will be substituted.
# These comments will also be removed.
root: index
subtrees:
  - caption: Start here
    entries:
    - file: install/installation
      title: Install ROCgdb
    - url: https://github.com/ROCm/ROCgdb/blob/amd-staging/README-ROCM.md
      title: Build from source
    - file: how-to/quick-start
      title: Quick start
    - file: start-here/debug-first-hip-kernel
      title: Debug your first HIP kernel
  - caption: Troubleshoot
    entries:
    - file: troubleshoot/index
      title: Troubleshoot ROCgdb sessions
      entries:
      - file: troubleshoot/kernel-breakpoint-not-hit
        title: Kernel breakpoint isn't hit
  - caption: Understand GPU debugging
    entries:
    - file: concepts/gpu-execution-state
      title: GPU execution state
  - caption: Commands and tools
    entries:
    - file: quick-reference/essential-commands
      title: Commands for key operations
    - file: how-to/third-party-tools
    - file: how-to/debugging-python
  - caption: Reference
    entries:
    - url: https://rocm.docs.amd.com/projects/ROCgdb/en/${branch}/ROCgdb/gdb/doc/gdb/index.html
      title: User guide (HTML)
    - url: https://rocm.docs.amd.com/projects/ROCgdb/en/${branch}/_static/pdf/ROCgdb/gdb.pdf
      title: User guide (PDF)
    - url: https://rocm.docs.amd.com/projects/ROCgdb/en/${branch}/ROCgdb/gdb/doc/gdb/AMD-GPU.html
      title: Debugging on AMD GPU
    - url: https://rocm.docs.amd.com/projects/ROCgdb/en/${branch}/ROCgdb/gdb/doc/gdb/Heterogeneous-Debugging.html
      title: Debugging heterogeneous programs
